Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Marker
      Name: Road surface (cosmetic)
      Enabled: true
      Topic:
        Value: /track_surface
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Walls (map)
      Enabled: true
      Alpha: 0.9
      Color Scheme: map
      Draw Behind: false
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/RobotModel
      Name: Ego car
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /ego_robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: ""
      Update Interval: 0
    - Class: rviz_default_plugins/RobotModel
      Name: Opponent car (enable for two-agent mode)
      Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /opp_robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: ""
      Update Interval: 0
    - Class: rviz_default_plugins/Marker
      Name: Start / finish line
      Enabled: true
      Topic:
        Value: /start_finish_line
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: Speed-coloured trail
      Enabled: true
      Topic:
        Value: /car_trail
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR
      Enabled: true
      Size (m): 0.04
      Style: Points
      Color: 255; 80; 80
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 1.5
    - Class: rviz_default_plugins/Image
      Name: Race HUD
      Enabled: true
      Normalize Range: false
      Topic:
        Value: /race_hud
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Global Options:
    Background Color: 20; 22; 28
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Scale: 9.0
      X: 0.0
      Y: 10.0
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Race HUD:
    collapsed: false
    hide_hud_tabs: false
  Width: 1400
  Height: 900
